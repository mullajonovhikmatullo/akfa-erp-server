NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/store_management
# Each application instance owns one pool. Budget total connections across all instances.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=60000
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=75000

# Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Required only when the database has no PLATFORM_OWNER yet.
PLATFORM_OWNER_USERNAME=platform_owner
PLATFORM_OWNER_PASSWORD=replace-with-a-strong-private-password
PLATFORM_OWNER_FULL_NAME=Platform Owner

ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
TRUST_PROXY=0
TRIAL_DAYS=1

LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
HANDOFF_RATE_LIMIT_MAX=20
SENSITIVE_ACTION_RATE_LIMIT_MAX=10
LOGIN_HANDOFF_TTL_MINUTES=5
ACCOUNT_SETUP_TTL_HOURS=24

# Local product image storage (MVP). Keep this directory outside Git.
UPLOAD_ROOT=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/uploads
PRODUCT_IMAGE_MAX_SIZE_MB=5
PRODUCT_IMAGE_MAX_COUNT=5
PRODUCT_IMAGE_CONCURRENT_UPLOADS=2
