# Install as root: install -m 644 deploy/erp-pos-backup.cron /etc/cron.d/erp-pos-backup
# Server clock is Europe/Berlin: 01:00 Berlin = 03:00/04:00 Tashkent.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 1 * * * deploy /srv/erp-pos/app/deploy/backup.sh >> /srv/erp-pos/backups/backup.log 2>&1
30 2 * * 0 deploy /srv/erp-pos/app/deploy/verify-backup.sh --remote >> /srv/erp-pos/backups/verify.log 2>&1
