COMPOSE_PROJECT_NAME=erp-pos
NODE_ENV=production
TZ=Asia/Tashkent

DOMAIN=mavion.uz
ALLOWED_ORIGINS=https://mavion.uz,https://www.mavion.uz

# Rewritten to the exact commit SHA by deploy/deploy.sh on every deploy.
BACKEND_IMAGE=ghcr.io/mullajonovhikmatullo/akfa-erp-server/backend:release
FRONTEND_IMAGE=ghcr.io/mullajonovhikmatullo/akfa-erp-client/frontend:release

POSTGRES_DB=erp_pos
POSTGRES_USER=erp_pos
POSTGRES_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
# Google sign-in endpoints answer 503 unless this is 1.
GOOGLE_SIGN_IN_ENABLED=0

PLATFORM_OWNER_USERNAME=hikmat
PLATFORM_OWNER_PASSWORD=replace-with-a-strong-private-password
PLATFORM_OWNER_FULL_NAME=Hikmat

PRODUCT_IMAGE_MAX_SIZE_MB=5
PRODUCT_IMAGE_MAX_COUNT=5
TRIAL_DAYS=14

# Per-process limits; see docs/PERFORMANCE.md before increasing pool size.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=60000
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=75000
PRODUCT_IMAGE_CONCURRENT_UPLOADS=2
PROFILE_PHOTO_CONCURRENT_UPLOADS=2
STORAGE_CONNECTION_TIMEOUT_MS=5000
STORAGE_REQUEST_TIMEOUT_MS=30000

# Product images live in Cloudflare R2.
STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Off-site backups (deploy/backup.sh). A separate R2 bucket with its own token,
# scoped to that bucket only (Object Read & Write). Leave empty to keep backups local.
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Defaults to R2_ENDPOINT.
BACKUP_R2_ENDPOINT=
BACKUP_REMOTE_RETENTION_DAYS=30
# Optional dead-man's switch (e.g. healthchecks.io): pinged after every successful backup.
BACKUP_HEARTBEAT_URL=
