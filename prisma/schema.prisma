generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PLATFORM_OWNER
  STORE_OWNER
  STORE_ADMIN
  BRANCH_ADMIN
  CASHIER
  ADMIN
}

enum StoreStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentCurrency {
  UZS
  USD
}

enum MediaKind {
  PAYMENT_RECEIPT
  PRODUCT_IMAGE
}

enum AuditAction {
  STORE_REGISTERED
  STORE_STATUS_CHANGED
  PAYMENT_CREATED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  SUBSCRIPTION_EXTENDED
  OWNER_ACCOUNT_ACTIVATED
  OWNER_SETUP_LINK_REGENERATED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ARCHIVED
  PLAN_DELETED
  ADMIN_CREATED
  ADMIN_UPDATED
  ADMIN_DISABLED
  ADMIN_ENABLED
}

enum HandoffPurpose {
  LOGIN
  ACCOUNT_SETUP
}

enum ProductUnit {
  KG
  PIECE
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum SaleType {
  RETAIL
  WHOLESALE
}

enum PaymentMethod {
  CASH_UZS
  CASH_USD
  CARD
  TRANSFER
  MIXED
  CREDIT
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpenseCurrency {
  UZS
  USD
}

// ─── Platform / Tenant Billing ───────────────────────────────────────────────

model Plan {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  monthlyPriceUzs Decimal        @default(0) @db.Decimal(18, 2)
  maxBranches     Int?
  maxUsers        Int?
  maxProducts     Int?
  isActive        Boolean        @default(true)
  isPublic        Boolean        @default(false)
  version         Int            @default(0)
  stores          Store[]
  subscriptions   Subscription[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive])
  @@index([isActive, isPublic])
}

model Store {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  ownerName         String?
  phone             String?
  email             String?
  status            StoreStatus       @default(TRIALING)
  planId            String?
  plan              Plan?             @relation(fields: [planId], references: [id])
  trialStartedAt    DateTime          @default(now())
  trialEndsAt       DateTime
  activatedAt       DateTime?
  suspendedAt       DateTime?
  billingVersion    Int               @default(0)
  subscription      Subscription?
  users             User[]
  branches          Branch[]
  productCategories ProductCategory[]
  products          Product[]
  inventories       Inventory[]
  stockBatches      StockBatch[]
  stockMovements    StockMovement[]
  customers         Customer[]
  sales             Sale[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  transfers         Transfer[]
  payments          Payment[]
  mediaObjects      MediaObject[]
  productImages     ProductImage[]
  auditLogs         AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([planId])
  @@index([trialEndsAt])
  @@index([createdAt])
}

model Subscription {
  id                 String             @id @default(uuid())
  storeId            String             @unique
  store              Store              @relation(fields: [storeId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  trialStartedAt     DateTime           @default(now())
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPaymentDueAt   DateTime?
  lastPaymentAt      DateTime?
  payments           Payment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

model Payment {
  id              String          @id @default(uuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id])
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  submittedById   String?
  submittedBy     User?           @relation("PaymentsSubmitted", fields: [submittedById], references: [id], onDelete: SetNull)
  receiptMediaId  String?         @unique
  receiptMedia    MediaObject?    @relation("PaymentReceipt", fields: [receiptMediaId], references: [id], onDelete: Restrict)
  amount          Decimal         @db.Decimal(18, 2)
  currency        PaymentCurrency @default(UZS)
  status          PaymentStatus   @default(PENDING)
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  approvedById    String?
  approvedBy      User?           @relation("PaymentsApproved", fields: [approvedById], references: [id])
  note            String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([subscriptionId])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
}

model MediaObject {
  id           String    @id @default(uuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  kind         MediaKind
  fileName     String
  mimeType     String
  sizeBytes    Int
  checksum     String
  content      Bytes
  payment      Payment?  @relation("PaymentReceipt")
  createdAt    DateTime  @default(now())

  @@index([storeId, kind])
  @@index([uploadedById])
  @@index([checksum])
}

model AuditLog {
  id        String      @id @default(uuid())
  storeId   String?
  store     Store?      @relation(fields: [storeId], references: [id])
  actorId   String?
  actor     User?       @relation("AuditLogActor", fields: [actorId], references: [id])
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([storeId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model AuthHandoff {
  id          String         @id @default(uuid())
  tokenHash   String         @unique
  purpose     HandoffPurpose
  userId      String
  user        User           @relation("AuthHandoffUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?          @relation("AuthHandoffCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

// ─── Branch ───────────────────────────────────────────────────────────────────

model Branch {
  id             String          @id @default(uuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  name           String
  address        String?
  phone          String?
  users          User[]
  customers      Customer[]
  inventories    Inventory[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  sales          Sale[]
  expenses       Expense[]
  payments       Payment[]
  transfersFrom  Transfer[]      @relation("TransfersFrom")
  transfersTo    Transfer[]      @relation("TransfersTo")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                 String          @id @default(uuid())
  storeId            String?
  store              Store?          @relation(fields: [storeId], references: [id])
  fullName           String
  username           String          @unique
  password           String
  role               UserRole
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  authVersion        Int             @default(0)
  branchId           String?
  branch             Branch?         @relation(fields: [branchId], references: [id])
  stockBatches       StockBatch[]
  stockMovements     StockMovement[]
  sales              Sale[]
  salePayments       SalePayment[]
  approvedPayments   Payment[]       @relation("PaymentsApproved")
  submittedPayments  Payment[]       @relation("PaymentsSubmitted")
  uploadedMedia      MediaObject[]
  auditLogs          AuditLog[]      @relation("AuditLogActor")
  authHandoffs       AuthHandoff[]   @relation("AuthHandoffUser")
  createdHandoffs    AuthHandoff[]   @relation("AuthHandoffCreator")
  expenses           Expense[]
  initiatedTransfers Transfer[]      @relation("TransfersInitiated")
  completedTransfers Transfer[]      @relation("TransfersCompleted")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([branchId])
  @@index([storeId])
  @@index([role])
}

// ─── Product Category ─────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id                String           @id @default(uuid())
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  name              String
  description       String?
  sku               String?
  unit              ProductUnit
  categoryId        String?
  category          ProductCategory? @relation(fields: [categoryId], references: [id])
  costPriceUzs      Decimal          @default(0) @db.Decimal(18, 2)
  retailPriceUzs    Decimal          @db.Decimal(18, 2)
  wholesalePriceUzs Decimal          @db.Decimal(18, 2)
  costPriceUsd      Decimal?         @db.Decimal(10, 4)
  retailPriceUsd    Decimal?         @db.Decimal(10, 4)
  wholesalePriceUsd Decimal?         @db.Decimal(10, 4)
  lowStockThreshold Decimal?         @db.Decimal(18, 4)
  isActive          Boolean          @default(true)
  inventories       Inventory[]
  stockBatches      StockBatch[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
  transferItems     TransferItem[]
  images            ProductImage[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([storeId, sku])
  @@unique([id, storeId])
  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([sku])
}

model ProductImage {
  id                  String   @id @default(uuid())
  storeId             String
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  storageKey          String   @unique
  thumbnailStorageKey String   @unique
  originalFilename    String
  mimeType            String
  fileSize            Int
  width               Int
  height              Int
  isPrimary           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productId])
  @@index([storeId])
  @@index([productId, sortOrder])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Inventory {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([storeId])
  @@index([branchId])
  @@index([productId])
}

// ─── StockBatch ───────────────────────────────────────────────────────────────

model StockBatch {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  initialQty   Decimal  @db.Decimal(18, 4)
  remainingQty Decimal  @db.Decimal(18, 4)
  costPriceUzs Decimal  @db.Decimal(18, 2)
  costPriceUsd Decimal? @db.Decimal(10, 4)
  supplierNote String?
  receivedAt   DateTime @default(now())
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([branchId, productId])
  @@index([remainingQty])
  @@index([receivedAt])
}

// ─── StockMovement ────────────────────────────────────────────────────────────

model StockMovement {
  id           String            @id @default(uuid())
  storeId      String
  store        Store             @relation(fields: [storeId], references: [id])
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(18, 4)
  balanceAfter Decimal           @db.Decimal(18, 4)
  note         String?
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([storeId])
  @@index([branchId, productId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  fullName  String
  phone     String?
  address   String?
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  isActive  Boolean  @default(true)
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([phone])
}

// ─── Sale ─────────────────────────────────────────────────────────────────────

model Sale {
  id             String        @id @default(uuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  soldById       String
  soldBy         User          @relation(fields: [soldById], references: [id])
  saleType       SaleType
  items          SaleItem[]
  payments       SalePayment[]
  totalAmountUzs Decimal       @db.Decimal(18, 2)
  paidAmountUzs  Decimal       @default(0) @db.Decimal(18, 2)
  debtAmountUzs  Decimal       @default(0) @db.Decimal(18, 2)
  debtDueDate    DateTime?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([customerId])
  @@index([soldById])
  @@index([createdAt])
  @@index([debtDueDate])
}

// ─── SaleItem ─────────────────────────────────────────────────────────────────

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(18, 4)
  unitPrice  Decimal @db.Decimal(18, 2)
  totalPrice Decimal @db.Decimal(18, 2)

  @@index([saleId])
  @@index([productId])
}

// ─── SalePayment ──────────────────────────────────────────────────────────────

model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  amountUzs     Decimal       @default(0) @db.Decimal(18, 2)
  amountUsd     Decimal       @default(0) @db.Decimal(10, 4)
  usdToUzsRate  Decimal?      @db.Decimal(18, 2)
  paymentMethod PaymentMethod
  note          String?
  receivedById  String
  receivedBy    User          @relation(fields: [receivedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([saleId])
}

// ─── Expense ──────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  description String?
  isActive    Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model Expense {
  id           String          @id @default(uuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id])
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount       Decimal         @db.Decimal(18, 2)
  currency     ExpenseCurrency @default(UZS)
  amountUsd    Decimal         @default(0) @db.Decimal(10, 4)
  usdToUzsRate Decimal?        @db.Decimal(18, 2)
  description  String?
  expenseDate  DateTime
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([branchId, expenseDate])
}

// ─── Transfer ─────────────────────────────────────────────────────────────────

model Transfer {
  id            String         @id @default(uuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  fromBranchId  String
  fromBranch    Branch         @relation("TransfersFrom", fields: [fromBranchId], references: [id])
  toBranchId    String
  toBranch      Branch         @relation("TransfersTo", fields: [toBranchId], references: [id])
  status        TransferStatus @default(PENDING)
  note          String?
  items         TransferItem[]
  initiatedById String
  initiatedBy   User           @relation("TransfersInitiated", fields: [initiatedById], references: [id])
  completedById String?
  completedBy   User?          @relation("TransfersCompleted", fields: [completedById], references: [id])
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([storeId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([createdAt])
}

// ─── TransferItem ─────────────────────────────────────────────────────────────

model TransferItem {
  id           String   @id @default(uuid())
  transferId   String
  transfer     Transfer @relation(fields: [transferId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @db.Decimal(18, 4)
  unitCostUzs  Decimal  @db.Decimal(18, 2)
  totalCostUzs Decimal  @db.Decimal(18, 2)

  @@index([transferId])
  @@index([productId])
}
